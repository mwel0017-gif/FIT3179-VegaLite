
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Is Sugar Hiding in Packaged Foods?",
    "subtitle": "Average sugar content across the 12 sweetest food categories",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "anchor": "start",
    "offset": 20
  },
  "width": 540,
  "height": 380,
  "data": {
    "url": "OpenHSR.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "calculate": "toNumber(datum.sugars_g_per_100g)",
      "as": "Sugar"
    },
    {
      "filter": "isValid(datum.Sugar) && isFinite(datum.Sugar) && datum.Sugar >= 0 && datum.Sugar <= 100"
    },
    {
      "filter": "isValid(datum['Product type']) && datum['Product type'] !== ''"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "Sugar",
          "as": "AvgSugar"
        },
        {
          "op": "count",
          "as": "ProductCount"
        }
      ],
      "groupby": ["Product type"]
    },
    {
      "filter": "datum.ProductCount >= 3"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "Rank"
        }
      ],
      "sort": [
        {
          "field": "AvgSugar",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.Rank <= 12"
    }
  ],
  "mark": {
    "type": "rect",
    "cornerRadius": 3,
    "stroke": "white",
    "strokeWidth": 3
  },
  "encoding": {
    "y": {
      "field": "Product type",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "AvgSugar",
        "order": "descending"
      },
      "axis": {
        "labelFontSize": 12,
        "labelLimit": 200,
        "ticks": false,
        "domain": false
      }
    },
    "x": {
      "field": "AvgSugar",
      "type": "quantitative",
      "title": "Average Sugar (g per 100g)",
      "axis": {
        "labelFontSize": 12
      }
    },
    "color": {
      "field": "AvgSugar",
      "type": "quantitative",
      "title": "Sugar (g)",
      "scale": {
        "scheme": "orangered"
      }
    },
    "tooltip": [
      {
        "field": "Product type",
        "title": "Food Category"
      },
      {
        "field": "AvgSugar",
        "title": "Average Sugar (g/100g)",
        "format": ".1f"
      },
      {
        "field": "ProductCount",
        "title": "Products Analysed"
      }
    ]
  },
  "config": {
    "view": {"stroke": null},
    "axis": {
      "grid": false,
      "titleFontSize": 13
    }
  }
}
