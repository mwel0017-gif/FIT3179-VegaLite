{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#3C6461",

  "title": {
    "text": "Is every product in the same aisle equally healthy?",
    "anchor": "start",
    "font": "Bricolage Grotesque",
    "fontSize": 28,
    "fontWeight": "bold",
    "color": "#F8F0E4",
    "offset": 24
  },

  "width": 900,
  "height": 65,

  "padding": {
    "left": 25,
    "right": 35,
    "top": 25,
    "bottom": 25
  },

  "data": {
    "url": "../data/OpenHSR.csv",
    "format": {"type": "csv"}
  },

  "transform": [
    {
      "calculate": "toNumber(datum.HSR)",
      "as": "star"
    },
    {
      "calculate": "lower(trim(datum['Product type']))",
      "as": "group_key"
    },
    {
      "filter": "isValid(datum.star) && datum.star >= 0.5 && datum.star <= 5 && isValid(datum.group_key) && datum.group_key != ''"
    },
    {
      "filter": "indexof(['food', 'foods processed', 'processed', 'packaged foods', 'processed foods', 'unknown'], datum.group_key) < 0"
    },
    {
      "calculate": "datum.group_key === 'cereals' ? 'Breakfast cereals' : datum.group_key === 'chips' ? 'Chips & crisps' : datum.group_key === 'soda' ? 'Soft drinks' : datum.group_key === 'meat' ? 'Meat products' : datum.group_key === 'vegetables' ? 'Vegetable products' : datum.group_key === 'sauce' ? 'Sauces' : datum.group_key === 'bakery' ? 'Bakery products' : datum.group_key === 'snacks' ? 'Snacks' : datum.group_key === 'milk' ? 'Milk' : datum.group_key === 'frozen foods' ? 'Frozen foods' : datum.group_key === 'canned foods' ? 'Canned foods' : datum.group_key === 'pasta, rice and grains' ? 'Pasta, rice and grains' : upper(substring(datum.group_key,0,1)) + substring(datum.group_key,1)",
      "as": "food_type"
    },
    {
      "joinaggregate": [
        {"op": "count", "as": "num_products"},
        {"op": "median", "field": "star", "as": "median_hsr"},
        {"op": "min", "field": "star", "as": "min_hsr"},
        {"op": "max", "field": "star", "as": "max_hsr"}
      ],
      "groupby": ["food_type"]
    },
    {
      "filter": "datum.num_products >= 8"
    },
    {
      "density": "star",
      "groupby": ["food_type", "median_hsr", "num_products", "min_hsr", "max_hsr"],
      "extent": [0.5, 5],
      "steps": 100,
      "bandwidth": 0.22
    },
    {
      "joinaggregate": [
        {"op": "max", "field": "density", "as": "peak"}
      ],
      "groupby": ["food_type"]
    },
    {
      "calculate": "datum.peak > 0 ? datum.density / datum.peak : 0",
      "as": "shape"
    }
  ],

  "mark": {
    "type": "area",
    "interpolate": "monotone",
    "fillOpacity": 0.9,
    "stroke": "#F4EEE3",
    "strokeWidth": 1
  },

  "encoding": {
    "x": {
      "field": "value",
      "type": "quantitative",
      "scale": {
        "domain": [0.5, 5],
        "nice": false
      },
      "axis": {
        "title": "Health Star Rating",
        "values": [0.5, 1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5],
        "grid": true,
        "labelOverlap": false,
        "labelPadding": 8
      }
    },

    "y": {
      "field": "shape",
      "type": "quantitative",
      "scale": {
        "domain": [0, 1.05],
        "nice": false,
        "zero": true
      },
      "axis": null
    },

    "fill": {
      "field": "median_hsr",
      "type": "quantitative",
      "scale": {
        "domain": [0.5, 5],
        "range": ["#E5AA3C", "#A6D0C1"],
        "clamp": true
      },
      "legend": {
        "title": "Median Health Star Rating",
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 320,
        "gradientThickness": 14,
        "values": [0.5, 1, 2, 3, 4, 5],
        "offset": 22,
        "titlePadding": 12,
        "labelOffset": 7
      }
    },

     "row": {
  "field": "food_type",
  "type": "nominal",
  "title": null,
  "sort": {
    "field": "median_hsr",
    "op": "max",
    "order": "descending"
  },
  "header": {
    "labelAngle": 0,
    "labelAlign": "right",
    "labelBaseline": "middle",
    "labelFont": "Bricolage Grotesque",
    "labelFontSize": 14,
    "labelColor": "#F4EEE3",
    "labelLimit": 230,
    "labelPadding": 15
  }
    },

    "tooltip": [
      {
        "field": "food_type",
        "type": "nominal",
        "title": "Food category"
      },
      {
        "field": "value",
        "type": "quantitative",
        "title": "Rating position",
        "format": ".2f"
      },
      {
        "field": "median_hsr",
        "type": "quantitative",
        "title": "Median HSR",
        "format": ".1f"
      },
      {
        "field": "min_hsr",
        "type": "quantitative",
        "title": "Lowest rating",
        "format": ".1f"
      },
      {
        "field": "max_hsr",
        "type": "quantitative",
        "title": "Highest rating",
        "format": ".1f"
      },
      {
        "field": "num_products",
        "type": "quantitative",
        "title": "Number of products",
        "format": ",d"
      }
    ]
  },

  "config": {
    "view": {"stroke": null},
    "facet": {"spacing": 8},
    "axis": {
      "labelColor": "#DCECE5",
      "titleColor": "#FFF5E7",
      "gridColor": "#A8C7BD",
      "gridOpacity": 0.18,
      "labelFont": "Bricolage Grotesque",
      "titleFont": "Bricolage Grotesque",
      "labelFontSize": 13,
      "titleFontSize": 16,
      "titlePadding": 16,
      "tickColor": "#90AFA6",
      "domainColor": "#90AFA6"
    },
    "legend": {
      "titleColor": "#FFF5E7",
      "labelColor": "#DCECE5",
      "titleFont": "Bricolage Grotesque",
      "labelFont": "Bricolage Grotesque",
      "titleFontSize": 15,
      "labelFontSize": 13
    },
    "header": {
      "labelFont": "Bricolage Grotesque",
      "labelColor": "#F4EEE3"
    }
  }
}