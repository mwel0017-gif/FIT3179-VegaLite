
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Health Star Rating uptake waffle chart with left and right annotations.",
  "background": "#3C6461",
  "width": 1420,
  "height": 558,
  "padding": 0,

  "title": {
    "text": "How Far Is Australia from the 70% HSR Target?",
    "anchor": "start",
    "font": "Bricolage Grotesque",
    "fontSize": 30,
    "fontWeight": "bold",
    "color": "#F8F0E4",
    "offset": 22
  },

  "config": {
    "view": {"stroke": null},
    "font": "Bricolage Grotesque"
  },

  "layer": [
    {
      "data": {
        "sequence": {
          "start": 0,
          "stop": 200,
          "step": 1
        }
      },
      "transform": [
        {
          "calculate": "floor(datum.data / 100)",
          "as": "panel"
        },
        {
          "calculate": "datum.data % 100",
          "as": "index"
        },
        {
          "calculate": "datum.panel === 0 ? 39 : 70",
          "as": "count"
        },
        {
          "calculate": "datum.index < datum.count",
          "as": "is_filled"
        },
        {
          "calculate": "(datum.panel === 0 ? 270 : 760) + (datum.index % 10) * 39",
          "as": "x_start"
        },
        {
          "calculate": "datum.x_start + 34",
          "as": "x_end"
        },
        {
          "calculate": "142 + floor(datum.index / 10) * 39",
          "as": "y_start"
        },
        {
          "calculate": "datum.y_start + 34",
          "as": "y_end"
        },
        {
          "calculate": "datum.panel === 0 ? '2025 actual uptake' : '2025 target'",
          "as": "measure"
        },
        {
          "calculate": "datum.panel === 0 ? (datum.is_filled ? 'HSR label displayed (39%)' : 'HSR label not displayed (61%)') : (datum.is_filled ? 'Part of the 70% target' : 'Outside the 70% target')",
          "as": "meaning"
        }
      ],

      "mark": {
        "type": "rect",
        "cornerRadius": 2
      },

      "encoding": {
        "x": {
          "field": "x_start",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1420],
            "range": [0, 1420],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "x2": {"field": "x_end"},
        "y": {
          "field": "y_start",
          "type": "quantitative",
          "scale": {
            "domain": [0, 558],
            "range": [0, 558],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "y2": {"field": "y_end"},
        "color": {
          "condition": {
            "test": "datum.is_filled",
            "value": "#9FC7BC"
          },
          "value": "#294F49",
          "legend": null
        },
        "tooltip": [
          {
            "field": "measure",
            "type": "nominal",
            "title": "Comparison"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Highlighted out of 100"
          },
          {
            "field": "meaning",
            "type": "nominal",
            "title": "Square represents"
          }
        ]
      }
    },

    {
      "data": {"values": [{}]},
      "mark": {
        "type": "circle",
        "size": 260,
        "filled": true,
        "color": "#9FC7BC"
      },
      "encoding": {
        "x": {"value": 270},
        "y": {"value": 38}
      }
    },
    {
      "data": {"values": [{}]},
