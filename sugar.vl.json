
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Added versus other sugars by food group. Values are unweighted means per 100 g. Free sugars appear only in tooltips.",
  "background": "#3C6461",
  "spacing": 5,
  "center": false,

  "title": {
    "text": [
      "How much of the sugar in everyday foods",
       "comes from added sugars?"
    ],
    "anchor": "start",
    "font": "Bricolage Grotesque",
    "fontSize": 30,
    "fontWeight": "bold",
    "color": "#F8F0E4",
    "lineHeight": 36,
    "offset": 22
  },

  "vconcat": [
    {
      "width": 450,
      "height": 88,
      "data": {
        "values": [{}]
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "size": 170,
            "filled": true,
            "color": "#E9B75B"
          },
          "encoding": {
            "x": {"value": 55},
            "y": {"value": 48}
          }
        },
        {
          "mark": {
            "type": "text",
            "font": "Bricolage Grotesque",
            "fontSize": 18,
            "fontWeight": "normal",
            "color": "#C7DBD3",
            "align": "left",
            "baseline": "middle"
          },
          "encoding": {
            "x": {"value": 75},
            "y": {"value": 48},
            "text": {"value": "Added sugars"}
          }
        },
        {
          "mark": {
            "type": "circle",
            "size": 170,
            "filled": true,
            "color": "#8FC4B4"
          },
          "encoding": {
            "x": {"value": 261},
            "y": {"value": 48}
          }
        },
        {
          "mark": {
            "type": "text",
            "font": "Bricolage Grotesque",
            "fontSize": 18,
            "fontWeight": "normal",
            "color": "#C7DBD3",
            "align": "left",
            "baseline": "middle"
          },
          "encoding": {
            "x": {"value": 281},
            "y": {"value": 48},
            "text": {"value": "Other sugars"}
          }
        }
      ]
    },

    {
      "hconcat": [
        {
          "width": 325,
          "height": 350,
          "data": {
            "values": [
              {"blank": " "}
            ]
          },
          "mark": {
            "type": "text",
            "opacity": 0
          },
          "encoding": {
            "x": {"value": 0},
            "y": {"value": 0},
            "text": {
              "field": "blank",
              "type": "nominal"
            }
          }
        },

        {
          "width": 350,
          "height": 350,
          "padding": {
            "left": 0,
            "right": 22,
            "top": 16,
            "bottom": 65
          },

          "data": {
            "values": [
              {
                "category": "Sweet biscuits",
                "profiles": 50,
                "mean_total_g": 32.46,
                "mean_added_g": 29.668,
                "mean_other_g": 2.792,
                "mean_free_g": 29.698,
                "added_share_pct": 91.4
              },
              {
                "category": "Snack bars",
                "profiles": 31,
                "mean_total_g": 23.823,
                "mean_added_g": 12.948,
                "mean_other_g": 10.874,
                "mean_free_g": 16.465,
                "added_share_pct": 54.4
              },
              {
                "category": "Commercial savoury sauces",
                "profiles": 35,
                "mean_total_g": 16.666,
                "mean_added_g": 14.48,
                "mean_other_g": 2.186,
                "mean_free_g": 14.569,
                "added_share_pct": 86.9
              },
              {
                "category": "Breakfast cereals",
                "profiles": 87,
                "mean_total_g": 14.874,
                "mean_added_g": 9.578,
                "mean_other_g": 5.295,
                "mean_free_g": 10.871,
                "added_share_pct": 64.4
              },
              {
                "category": "Fruit juices",
                "profiles": 30,
                "mean_total_g": 10.237,
                "mean_added_g": 0.23,
                "mean_other_g": 10.007,
                "mean_free_g": 8.507,
                "added_share_pct": 2.2
              },
              {
                "category": "Flavoured yoghurts",
                "profiles": 19,
                "mean_total_g": 8.363,
                "mean_added_g": 3.105,
                "mean_other_g": 5.258,
                "mean_free_g": 3.111,
                "added_share_pct": 37.1
              },
              {
                "category": "Soft drinks",
                "profiles": 20,
                "mean_total_g": 7.26,
                "mean_added_g": 7.06,
                "mean_other_g": 0.2,
                "mean_free_g": 7.065,
                "added_share_pct": 97.2
              }
            ]
          },

          "layer": [
            {
              "transform": [
                {
                  "fold": [
                    "mean_added_g",
                    "mean_other_g"
                  ],
                  "as": [
                    "sugar_key",
                    "amount_g"
                  ]
                },
                {
                  "calculate": "datum.sugar_key === 'mean_added_g' ? 'Added sugars' : 'Other sugars'",
                  "as": "sugar_component"
                },
                {
                  "calculate": "format(datum.added_share_pct, '.1f') + '%'",
                  "as": "addedShareDisplay"
                }
              ],

              "mark": {
                "type": "bar",
                "size": 34,
                "cornerRadiusEnd": 0,
                "opacity": 0.94
              },

              "encoding": {
                "x": {
                  "field": "amount_g",
                  "type": "quantitative",
                  "stack": "zero",
                  "scale": {
                    "domain": [0, 37.8],
                    "nice": false,
                    "zero": true
                  },
                  "axis": {
                    "title": "Average sugars (g per 100 g)",
                    "values": [
                      0, 5, 10, 15, 20, 25, 30, 35
                    ],
                    "grid": true,
                    "gridColor": "#8FB0A6",
                    "gridOpacity": 0.19,
                    "labelColor": "#F8F0E4",
                    "titleColor": "#F8F0E4",
                    "labelFont": "Bricolage Grotesque",
                    "titleFont": "Bricolage Grotesque",
                    "labelFontSize": 16,
                    "titleFontSize": 18,
                    "labelPadding": 9,
                    "titlePadding": 20,
                    "tickColor": "#C7DBD3",
                    "domainColor": "#C7DBD3",
                    "domain": true,
                    "ticks": true,
                    "tickSize": 7,
                    "labelFlush": false,
                    "domainWidth": 1.5,
                    "labels": true
                  }
                },

                "y": {
                  "field": "category",
                  "type": "nominal",
                  "sort": [
                    "Sweet biscuits",
                    "Snack bars",
                    "Commercial savoury sauces",
                    "Breakfast cereals",
                    "Fruit juices",
                    "Flavoured yoghurts",
                    "Soft drinks"
                  ],
                  "axis": {
                    "title": "Food group",
                    "labelColor": "#F8F0E4",
                    "labelFont": "Bricolage Grotesque",
                    "labelFontSize": 17,
                    "labelPadding": 13,
                    "labelLimit": 310,
                    "grid": false,
                    "ticks": false,
                    "domain": true,
                    "titleColor": "#F8F0E4",
                    "titleFont": "Bricolage Grotesque",
                    "titleFontSize": 18,
                    "titlePadding": 44,
                    "domainColor": "#C7DBD3",
                    "domainWidth": 1.3,
                    "labels": true
                  }
                },

                "color": {
                  "field": "sugar_component",
                  "type": "nominal",
                  "scale": {
                    "domain": [
                      "Added sugars",
                      "Other sugars"
                    ],
                    "range": [
                      "#E9B75B",
                      "#8FC4B4"
                    ]
                  },
                  "legend": null
                },

                "order": {
                  "field": "sugar_key",
                  "type": "nominal",
                  "sort": "ascending"
                },

                "tooltip": [
                  {
                    "field": "category",
                    "type": "nominal",
                    "title": "Food group"
                  },
                  {
                    "field": "profiles",
                    "type": "quantitative",
                    "title": "AUSNUT food profiles"
                  },
                  {
                    "field": "mean_total_g",
                    "type": "quantitative",
                    "title": "Average total sugars (g/100 g)",
                    "format": ".1f"
                  },
                  {
                    "field": "mean_added_g",
                    "type": "quantitative",
                    "title": "Average added sugars (g/100 g)",
                    "format": ".1f"
                  },
                  {
                    "field": "mean_other_g",
                    "type": "quantitative",
                    "title": "Average other sugars (g/100 g)",
                    "format": ".1f"
                  },
                  {
                    "field": "mean_free_g",
                    "type": "quantitative",
                    "title": "Average free sugars (g/100 g)",
                    "format": ".1f"
                  },
                  {
                    "field": "addedShareDisplay",
                    "type": "nominal",
                    "title": "Added share of total sugars"
                  }
                ]
              }
            },

            {
              "transform": [
                {
                  "calculate": "format(datum.mean_total_g, '.1f') + ' g'",
                  "as": "total_label"
                }
              ],

              "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "dx": 12,
                "font": "Bricolage Grotesque",
                "fontSize": 17,
                "fontWeight": "bold",
                "color": "#F8F0E4"
              },

              "encoding": {
                "x": {
                  "field": "mean_total_g",
                  "type": "quantitative",
                  "scale": {
                    "domain": [0, 37.8],
                    "nice": false,
                    "zero": true
                  },
                  "axis": {
                    "title": "Average sugars (g per 100 g)",
                    "values": [
                      0, 5, 10, 15, 20, 25, 30, 35
                    ],
                    "grid": true,
                    "gridColor": "#8FB0A6",
                    "gridOpacity": 0.19,
                    "labelColor": "#F8F0E4",
                    "titleColor": "#F8F0E4",
                    "labelFont": "Bricolage Grotesque",
                    "titleFont": "Bricolage Grotesque",
                    "labelFontSize": 16,
                    "titleFontSize": 18,
                    "labelPadding": 9,
                    "titlePadding": 20,
                    "tickColor": "#C7DBD3",
                    "domainColor": "#C7DBD3",
                    "domain": true,
                    "ticks": true,
                    "tickSize": 7,
                    "labelFlush": false,
                    "domainWidth": 1.5,
                    "labels": true
                  }
                },

                "y": {
                  "field": "category",
                  "type": "nominal",
                  "sort": [
                    "Sweet biscuits",
                    "Snack bars",
                    "Commercial savoury sauces",
                    "Breakfast cereals",
                    "Fruit juices",
                    "Flavoured yoghurts",
                    "Soft drinks"
                  ],
                  "axis": {
                    "title": "Food group",
                    "labelColor": "#F8F0E4",
                    "labelFont": "Bricolage Grotesque",
                    "labelFontSize": 17,
                    "labelPadding": 13,
                    "labelLimit": 310,
                    "grid": false,
                    "ticks": false,
                    "domain": true,
                    "titleColor": "#F8F0E4",
                    "titleFont": "Bricolage Grotesque",
                    "titleFontSize": 18,
                    "titlePadding": 44,
                    "domainColor": "#C7DBD3",
                    "domainWidth": 1.3,
                    "labels": true
                  }
                },

                "text": {
                  "field": "total_label",
                  "type": "nominal"
                }
              }
            }
          ]
        }
      ],

      "spacing": 0,
      "bounds": "flush",
      "center": false
    }
  ],

  "config": {
    "font": "Bricolage Grotesque",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Bricolage Grotesque",
      "titleFont": "Bricolage Grotesque"
    }
  }
}
