
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "What's Inside Australia's Packaged Foods?",
    "subtitle": "Average nutritional content by food category",
    "fontSize": 19,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": 440,
  "height": 400,
  "data": {
    "url": "OpenHSR.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "filter": "isValid(datum['Product type']) && datum['Product type'] !== ''"
    },
    {
      "fold": [
        "sugars_g_per_100g",
        "saturated_fat_g_per_100g",
        "sodium_mg_per_100g"
      ],
      "as": ["Nutrient", "Value"]
    },
    {
      "calculate": "toNumber(datum.Value)",
      "as": "NutrientValue"
    },
    {
      "filter": "isValid(datum.NutrientValue) && isFinite(datum.NutrientValue) && datum.NutrientValue >= 0"
    },
    {
      "calculate": "datum.Nutrient === 'sugars_g_per_100g' ? 'Sugar' : datum.Nutrient === 'saturated_fat_g_per_100g' ? 'Saturated fat' : 'Sodium'",
      "as": "NutrientName"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "NutrientValue",
          "as": "Average"
        },
        {
          "op": "count",
          "as": "Count"
        }
      ],
      "groupby": ["Product type", "NutrientName"]
    },
    {
      "filter": "datum.Count >= 3"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "Average",
          "as": "MaxAverage"
        }
      ],
      "groupby": ["NutrientName"]
    },
    {
      "calculate": "datum.MaxAverage > 0 ? datum.Average / datum.MaxAverage : 0",
      "as": "RelativeValue"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "NutrientName",
      "type": "nominal",
      "title": null,
      "sort": [
        "Sugar",
        "Saturated fat",
        "Sodium"
      ],
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12
      }
    },
    "y": {
      "field": "Product type",
      "type": "nominal",
      "title": "Food Category",
      "axis": {
        "labelFontSize": 11,
        "labelLimit": 170
      }
    },
    "color": {
      "field": "RelativeValue",
      "type": "quantitative",
      "title": "Relative level",
      "scale": {
        "scheme": "blues",
        "domain": [0, 1]
      }
    },
    "tooltip": [
      {
        "field": "Product type",
        "title": "Food category"
      },
      {
        "field": "NutrientName",
        "title": "Nutrient"
      },
      {
        "field": "Average",
        "title": "Average nutrient value",
        "format": ".1f"
      },
      {
        "field": "Count",
        "title": "Number of products"
      }
    ]
  },
  "config": {
    "view": {"stroke": null},
    "axis": {"grid": false}
  }
}
